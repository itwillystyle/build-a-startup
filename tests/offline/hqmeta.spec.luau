--[[ hqmeta.spec.luau: the three HQ paths describe the same building.

Why this exists. Wafers.lua's `template(name)` returns the imported mesh ONLY if
both the mesh is in the place AND `HQMeta[name]` exists:

	if tpl and META[name] then return tpl end
	return nil

A nil template is not an error -- it is the signal to build the primitive
fallback instead. That is the right behaviour when a kit has not been imported
yet, but it means a kit that is imported and MISSING ITS META SILENTLY BUILDS
THE PRIMITIVE VERSION FOREVER, with nothing in the output to say so. The podium
and crown were found that way by hand.

So: every mesh name the placer asks for must have a META entry under all three
prefixes, and the three kits must agree on what pieces a building is made of.
The META files are generated by blender/wafers.py, terrafab.py and dome.py
through metafile.py, so this also catches a Blender run that exported one kit
and not the others. ]]

local fs = require("@lune/fs")

local PREFIX = { Wafers = "W_", Terrafab = "T_", Dome = "D_" }
local kit = {
	Wafers = require("../../src/ServerScriptService/HQMeta/Wafers"),
	Terrafab = require("../../src/ServerScriptService/HQMeta/Terrafab"),
	Dome = require("../../src/ServerScriptService/HQMeta/Dome"),
}

-- Pieces a path is allowed to be missing, and why. Anything NOT listed here is a
-- bug, so adding a line is a deliberate act with a reason attached.
local ALLOWED_GAPS = {
	Terrafab = {
		PodiumGlass = "the Terrafab base is a solid service plinth (dock lip, shutters, "
			.. "bollards), so it has no glass. Wafers.lua places it behind `if pg then`.",
	},
}

local T = {}
local function test(name, fn)
	table.insert(T, { name = name, fn = fn })
end

local function suffixes(t, prefix)
	local out = {}
	for k in pairs(t) do
		local s = k:match("^" .. prefix .. "(.+)$")
		if s then
			out[s] = true
		end
	end
	return out
end

--[[ RETIRED 14 Oct (HQ tower 1a): "every mesh name the placer asks for has a META entry".
	The placer (Wafers.lua) builds the rectangular tower in plain parts and asks for no
	W_ meshes; the round kit is kept on disk but unused. Part 1d adds the tower kit and a
	name contract for it. The kit-shape tests below still check the old kit files. ]]

test("the three kits describe the same pieces", function()
	local ref = suffixes(kit.Wafers, "W_")
	for kitName, prefix in pairs(PREFIX) do
		if kitName ~= "Wafers" then
			local mine = suffixes(kit[kitName], prefix)
			local gaps = ALLOWED_GAPS[kitName] or {}
			local lacks, extra = {}, {}
			for s in pairs(ref) do
				if not mine[s] and not gaps[s] then
					table.insert(lacks, s)
				end
			end
			for s in pairs(mine) do
				if not ref[s] then
					table.insert(extra, s)
				end
			end
			table.sort(lacks)
			table.sort(extra)
			assert(#lacks == 0, ("%s is missing: %s"):format(kitName, table.concat(lacks, ", ")))
			assert(#extra == 0, ("%s has pieces Wafers does not: %s"):format(kitName, table.concat(extra, ", ")))
		end
	end
end)

test("every entry has a centre and a size with real, positive extents", function()
	for kitName, prefix in pairs(PREFIX) do
		for name, m in pairs(kit[kitName]) do
			assert(name:sub(1, #prefix) == prefix, ("%s holds a foreign key %s"):format(kitName, name))
			assert(m.c and m.s, ("%s has no c/s"):format(name))
			for _, axis in ipairs({ "X", "Y", "Z" }) do
				local c, s = m.c[axis], m.s[axis]
				assert(c == c and c ~= math.huge and c ~= -math.huge, ("%s centre %s is not a real number"):format(name, axis))
				assert(s > 0, ("%s size %s is %s -- a piece with no extent never renders"):format(name, axis, tostring(s)))
			end
		end
	end
end)

test("the base and the crown are present on every path", function()
	-- v7: the three buildings were pure shaft until these landed. If a future
	-- Blender run drops them the towers go back to starting and stopping in mid
	-- air, which is the exact thing this pass existed to fix.
	for kitName, prefix in pairs(PREFIX) do
		for _, stem in ipairs({ "Podium", "Crown" }) do
			assert(kit[kitName][prefix .. stem] ~= nil, ("%s has lost its %s"):format(kitName, stem))
		end
		local crown = kit[kitName][prefix .. "Crown"]
		assert(crown.s.Y > 8, ("%s crown is only %.1f studs tall -- the old one-hoop crown was 1.6"):format(kitName, crown.s.Y))
	end
end)

return T
