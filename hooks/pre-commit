#!/bin/sh
# Refuses a commit when selene finds an ERROR in a staged Lua/Luau file.
# Warnings pass. The error it exists for: calling a local function above the
# line that defines it (selene: undefined_variable), which crashed the game 7+ times.
# Enabled by: git config core.hooksPath hooks   (already set in this repo)
# Skip once, only if you must: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
SELENE="$HOME/.rokit/bin/selene"
[ -x "$SELENE" ] || SELENE="$HOME/.rokit/bin/selene.exe"
if [ ! -x "$SELENE" ]; then
	echo "pre-commit: selene not found in ~/.rokit/bin, lint skipped" >&2
	exit 0
fi
FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.lua' '*.luau')
[ -z "$FILES" ] && exit 0
# shellcheck disable=SC2086
OUT=$(PATH="$HOME/.rokit/bin:$PATH" "$SELENE" --allow-warnings --display-style quiet $FILES 2>&1)
if [ $? -ne 0 ]; then
	echo "pre-commit: selene found errors, commit refused:" >&2
	echo "$OUT" | grep -i "error" >&2
	exit 1
fi
exit 0
