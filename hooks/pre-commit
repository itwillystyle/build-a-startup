#!/bin/sh
# Refuses a commit when a staged Lua/Luau file is not valid UTF-8, when selene finds an ERROR,
# or when the offline tests (tests/offline, run in Lune) fail.
# Warnings pass. The error it exists for: calling a local function above the
# line that defines it (selene: undefined_variable), which crashed the game 7+ times.
# Enabled by: git config core.hooksPath hooks   (already set in this repo)
# Skip once, only if you must: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.lua' '*.luau')
FILES=$(echo "$FILES" | grep -v '^Packages/')   # third-party (Wally) code is not ours to lint
[ -z "$FILES" ] && exit 0
# Every staged Lua/Luau file must be valid UTF-8 (selene does not check). A Latin-1
# byte, e.g. a pasted middle dot, renders garbled and can stop Rojo syncing the file.
# It checks the STAGED blob, not the working copy. This guard FAILS LOUDLY: if no
# working python is found, or the checker itself breaks, the commit is refused.
# (SV_PYTHON overrides the interpreter; each candidate is run once, because on
# Windows "python3" can be a Store stub that exists but does nothing.)
PY=""
for cand in "$SV_PYTHON" python3 python py; do
	[ -n "$cand" ] || continue
	if "$cand" -c "import sys" >/dev/null 2>&1; then PY="$cand"; break; fi
done
if [ -z "$PY" ]; then
	echo "pre-commit: no working python found, so the UTF-8 check cannot run; commit refused." >&2
	echo "  Install python, or skip the hooks once with: git commit --no-verify" >&2
	exit 1
fi
BAD=$(echo "$FILES" | "$PY" hooks/check_utf8.py)
RC=$?
if [ $RC -eq 1 ]; then
	echo "pre-commit: invalid UTF-8, commit refused:" >&2
	echo "$BAD" >&2
	exit 1
elif [ $RC -ne 0 ]; then
	echo "pre-commit: the UTF-8 checker failed (exit $RC), commit refused." >&2
	echo "  Fix hooks/check_utf8.py, or skip the hooks once with: git commit --no-verify" >&2
	exit 1
fi
SELENE="$HOME/.rokit/bin/selene"
[ -x "$SELENE" ] || SELENE="$HOME/.rokit/bin/selene.exe"
if [ ! -x "$SELENE" ]; then
	echo "pre-commit: selene not found in ~/.rokit/bin, lint skipped" >&2
	exit 0
fi
# shellcheck disable=SC2086
OUT=$(PATH="$HOME/.rokit/bin:$PATH" "$SELENE" --allow-warnings --display-style quiet $FILES 2>&1)
if [ $? -ne 0 ]; then
	echo "pre-commit: selene found errors, commit refused:" >&2
	echo "$OUT" | grep -i "error" >&2
	exit 1
fi
# The offline tests (Lune, ~0.2 s): the pure economy rules must still pass.
LUNE="$HOME/.rokit/bin/lune"
[ -x "$LUNE" ] || LUNE="$HOME/.rokit/bin/lune.exe"
if [ -x "$LUNE" ] && [ -f tests/offline/run.luau ]; then
	TOUT=$(PATH="$HOME/.rokit/bin:$PATH" "$LUNE" run tests/offline/run 2>&1)
	if [ $? -ne 0 ]; then
		echo "pre-commit: offline tests failed, commit refused:" >&2
		echo "$TOUT" >&2
		exit 1
	fi
fi
exit 0
